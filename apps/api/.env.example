# ---------------------------------------------------------------- database
# Local dev default (created by `npm run setup` / `npm run db:local`).
# Supabase / RDS / Neon work too — paste the connection string here.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/applyai
# Set to true for hosted databases that require TLS (most managed providers).
DATABASE_SSL=false
DB_POOL_MAX=10

# ---------------------------------------------------------------- auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
# Where the browser loads the app from (comma separated for multiple origins).
CLIENT_URL=http://localhost:5173
# Extra origins Better Auth should accept (optional; defaults to CLIENT_URL).
TRUSTED_ORIGINS=

# ---------------------------------------------------------------- server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------- optional: ML service
# Adds embedding-based matching and PDF/DOCX resume parsing. The product works
# without it — matching falls back to the local taxonomy + TF-IDF engine.
ML_SERVICE_URL=http://localhost:5000
ML_TIMEOUT_MS=12000

# ---------------------------------------------------------------- optional: local LLM
# Ollama generates cover letters. Without it, the built-in template engine is
# used (grounded in your resume, no API cost).
OLLAMA_URL=
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=60000

# ---------------------------------------------------------------- job discovery
# Company board tokens for the ATS providers (comma separated).
GREENHOUSE_BOARDS=stripe,figma,notion,vercel,datadog,gitlab,discord,airtable,reddit,anthropic,openai,samsara,affirm,doordash
LEVER_COMPANIES=netflix,spotify,plaid,ramp,brex,attentive
ASHBY_BOARDS=openai,ramp,linear,clay,notion,replit
# Turn individual sources off, e.g. DISABLED_JOB_SOURCES=remoteok,arbeitnow
DISABLED_JOB_SOURCES=
DISCOVERY_TIMEOUT_MS=10000
DISCOVERY_CACHE_TTL_MS=300000

# ---------------------------------------------------------------- rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
